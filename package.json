{
  "name": "nuviloview-oem",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "test": "node --test tests/*.test.mjs",
    "bot": "node scripts/token-leak-check.mjs && node --env-file=.env.local discord-bot.mjs",
    "bot:control": "powershell.exe -NoProfile -ExecutionPolicy Bypass -STA -File scripts/bot-control-ui.ps1",
    "monitor:runtime": "node --env-file=.env.local scripts/monitor-runtime.mjs --watch",
    "monitor:runtime:once": "node --env-file=.env.local scripts/monitor-runtime.mjs --json",
    "test:runtime:failover": "node --env-file=.env.local scripts/test-runtime-failover.mjs --execute-test-service",
    "health:calibrate": "node --env-file=.env.local scripts/calibrate-health-v2.mjs",
    "security:tokens": "node scripts/token-leak-check.mjs",
    "db:migrate": "node --env-file=.env.local scripts/migrate.mjs",
    "privacy:anonymize-discord-email": "node --env-file=.env.local scripts/anonymize-discord-emails.mjs",
    "companion": "pnpm --dir companion start"
  },
  "dependencies": {
    "@base-ui/react": "^1.5.0",
    "@neondatabase/serverless": "^1.1.0",
    "@vercel/analytics": "1.6.1",
    "better-auth": "^1.6.25",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "discord.js": "^14.27.0",
    "drizzle-orm": "^0.45.2",
    "lucide-react": "^1.27.0",
    "next": "16.2.12",
    "pg": "^8.22.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwind-merge": "^3.3.1",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^24",
    "@types/pg": "^8.20.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.2.12",
    "postcss": "8.5.24",
    "shadcn": "^4.16.0",
    "tailwindcss": "^4.3.3",
    "typescript": "5.7.3"
  }
}
