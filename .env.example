# Production URL (set this exact URL in Vercel's Production environment)
BETTER_AUTH_URL=https://nuviloview-oem.vercel.app
BETTER_AUTH_TRUSTED_ORIGINS=https://nuviloview-oem.vercel.app

# Generate a long random value. Never commit the real value.
BETTER_AUTH_SECRET=

# Optional dedicated key for tamper-evident developer audit records.
# Set the same value on Vercel and the Bot host. BETTER_AUTH_SECRET is used
# as a compatibility fallback when this is not set.
AUDIT_LOG_SIGNING_SECRET=

# Optional private Discord webhook for critical Bot errors. Do not use a
# public channel webhook. Alerts are rate-limited and token values are redacted.
ALERT_WEBHOOK_URL=

# Discord OAuth application credentials
NUVILOVIEW_CLIENT_ID=
NUVILOVIEW_CLIENT_SECRET=

# Neon PostgreSQL connection string
DATABASE_URL=

# Phase 1 local storage foundation. Both flags stay OFF until a later staged
# migration explicitly routes a Bot data domain to SQLite. With storage OFF,
# no local database file is opened or created.
LOCAL_STORAGE_ENABLED=false
LOCAL_STORAGE_WRITE_ENABLED=false
LOCAL_STORAGE_PATH=./data/nuviloview.sqlite

# Phase 3A Message routing. OFF preserves the legacy Neon path. Enabling this
# also requires both LOCAL_STORAGE flags above. Never force a rollback while
# Message Outbox items are pending unless reconciliation has been planned.
# Global ON with an empty Canary list still routes every Guild to Legacy.
LOCAL_MESSAGE_STORAGE_ENABLED=false
LOCAL_MESSAGE_CANARY_GUILDS=
LOCAL_MESSAGE_STORAGE_FORCE_LEGACY_WITH_PENDING=false
MESSAGE_CANARY_READONLY_DATABASE_URL=
MESSAGE_CANARY_PENDING_WARN=500
MESSAGE_CANARY_PENDING_ABORT=5000
MESSAGE_CANARY_OLDEST_PENDING_WARN_SECONDS=120
MESSAGE_CANARY_OLDEST_PENDING_ABORT_SECONDS=600
MESSAGE_CANARY_SYNC_LAG_WARN_SECONDS=120
MESSAGE_CANARY_SYNC_LAG_ABORT_SECONDS=600
MESSAGE_CANARY_CIRCUIT_OPEN_ABORT_SECONDS=300
MESSAGE_CANARY_WAL_WARN_BYTES=268435456
MESSAGE_CANARY_WAL_ABORT_BYTES=536870912
MESSAGE_CANARY_DISK_WARN_BYTES=2147483648
MESSAGE_CANARY_DISK_ABORT_BYTES=536870912

# Phase 2 local Outbox Worker. These remain OFF until a later staged rollout.
# The Worker is a separate process and does not change discord-bot.mjs routing.
SYNC_WORKER_ENABLED=false
SYNC_NEON_REPLICA_ENABLED=false
SYNC_BATCH_MIN=25
SYNC_BATCH_MAX=100
SYNC_BATCH_GROWTH_STEP=10
SYNC_IDLE_MS=5000
SYNC_MAX_ATTEMPTS=8
SYNC_RETRY_BASE_MS=1000
SYNC_RETRY_MAX_MS=300000
SYNC_RETRY_JITTER_RATIO=0.2
SYNC_CIRCUIT_FAILURE_THRESHOLD=5
SYNC_CIRCUIT_OPEN_MS=60000
SYNC_CIRCUIT_HALF_OPEN_BATCH=5
SYNC_LOCK_TIMEOUT_MS=300000
SYNC_QUERY_TIMEOUT_MS=15000
SYNC_INTEGRITY_INTERVAL_MS=300000
SYNC_CHECKPOINT_INTERVAL_MS=60000
SYNC_METRICS_INTERVAL_MS=30000
SYNC_METRICS_PATH=./data/runtime/sync-worker-health.json
SYNC_OUTBOX_RETENTION_DAYS=7
SYNC_OUTBOX_RETENTION_BATCH=500
SYNC_OUTBOX_RETENTION_INTERVAL_MS=3600000
SYNC_QUEUE_WARN_COUNT=50000
SYNC_QUEUE_CRITICAL_COUNT=200000
SYNC_OLDEST_PENDING_WARN_MS=3600000
SYNC_OLDEST_PENDING_CRITICAL_MS=86400000
SQLITE_DISK_WARN_BYTES=5000000000
SQLITE_DISK_CRITICAL_BYTES=10000000000
SQLITE_WAL_WARN_BYTES=536870912
SQLITE_WAL_CRITICAL_BYTES=1073741824
SQLITE_FREE_WARN_BYTES=2147483648
SQLITE_FREE_CRITICAL_BYTES=536870912

# Discord Bot only: set this in the Bot host, never in Vercel.
NUVILOVIEW_BOT_TOKEN=
DISCORD_DEV_GUILD_ID=
# Discord user ID allowed to run /botservers in the development server only.
DISCORD_OWNER_USER_ID=

# Local LibreTranslate endpoint for the optional right-click translation.
# This stays on the Bot PC by default and does not send messages to an external API.
LIBRETRANSLATE_URL=http://127.0.0.1:5000
# Displayed in the translation picker. Update this when LibreTranslate is upgraded.
LIBRETRANSLATE_VERSION=1.9.6

# Message-body retention period in days (optional; defaults to 90)
MESSAGE_RETENTION_DAYS=90

# Message History Import v2 is staged and remains unavailable until the
# additive migration has been reviewed and applied on the target environment.
MESSAGE_HISTORY_IMPORT_V2_ENABLED=false
MESSAGE_HISTORY_IMPORT_STALL_SECONDS=120
MESSAGE_HISTORY_IMPORT_MAX_RETRIES=5
MESSAGE_HISTORY_IMPORT_MAX_PAGES_PER_CHANNEL=50000

# Backup v2 is intentionally not registered in Windows Startup. Run it as a
# BotCenter one-shot/scheduled Worker only after a dry run and restore check.
# Encryption is optional; when enabled, keep the passphrase in BotCenter/host
# secret storage and never in this file, Git, manifests, or command arguments.
NUVILOVIEW_BACKUP_ENCRYPTION_ENABLED=false
NUVILOVIEW_BACKUP_ENCRYPTION_PASSPHRASE=

# Health Score v2 release control. Keep preview + shadow until calibration is
# approved. Only an explicit "stable" stage may write the official score field.
HEALTH_V2_RELEASE_STAGE=preview
HEALTH_V2_SHADOW_WRITE_ENABLED=true

# Automatic spam protection. Three messages from one member or Bot inside five
# seconds triggers a temporary timeout attempt and moderator action buttons.
SPAM_PROTECTION_ENABLED=true
SPAM_MESSAGE_LIMIT=3
SPAM_WINDOW_SECONDS=5
SPAM_TIMEOUT_MINUTES=5
SPAM_DETECTION_COOLDOWN_MINUTES=10

# External uptime monitoring (set in Vercel only; use a long random value).
# The monitor URL becomes /api/monitor/bot?token=THIS_VALUE
BOT_MONITOR_TOKEN=
BOT_HEARTBEAT_MAX_AGE_SECONDS=180

# Cross-host Discord Bot singleton. Run the additive migration first, then set
# the same service key on every production host. Give each host a unique ID.
NUVILOVIEW_DISTRIBUTED_SINGLETON=false
NUVILOVIEW_DEPLOYMENT_ENV=production
NUVILOVIEW_SERVICE_KEY=nuviloview.discord-bot.production
NUVILOVIEW_HOST_ID=
NUVILOVIEW_LEASE_TTL_SECONDS=45
NUVILOVIEW_LEASE_RENEW_SECONDS=15
NUVILOVIEW_HEARTBEAT_SECONDS=15
NUVILOVIEW_LEASE_SAFETY_SECONDS=5
NUVILOVIEW_HEARTBEAT_RETENTION_DAYS=30

# Independent runtime monitor. It does not use the Discord Bot token. Prefer a
# dedicated read-only DATABASE_URL and run it outside the active Bot host.
NUVILOVIEW_MONITOR_HOST_ID=external-monitor
NUVILOVIEW_MONITOR_EXPECT_SINGLETON=false
NUVILOVIEW_MONITOR_INTERVAL_SECONDS=30
NUVILOVIEW_MONITOR_WARNING_SECONDS=45
NUVILOVIEW_MONITOR_CRITICAL_SECONDS=90
NUVILOVIEW_MONITOR_RESTART_WINDOW_MINUTES=10
NUVILOVIEW_MONITOR_RESTART_THRESHOLD=5
NUVILOVIEW_MONITOR_CONTENTION_THRESHOLD=5
NUVILOVIEW_MONITOR_WEBHOOK_URL=
NUVILOVIEW_MONITOR_STATE_FILE=./data/runtime-monitor/state.json
NUVILOVIEW_MONITOR_LOG_FILE=./logs/runtime-monitor.log
NUVILOVIEW_MONITOR_WEB_URL=https://nuviloview-oem.vercel.app/api/monitor/bot
NUVILOVIEW_MONITOR_BACKUP_STATUS_FILE=./logs/backup-status.json
NUVILOVIEW_MONITOR_DB_WARNING_MS=750
NUVILOVIEW_MONITOR_DB_CRITICAL_MS=2000
NUVILOVIEW_MONITOR_API_WARNING_MS=1500
NUVILOVIEW_MONITOR_API_CRITICAL_MS=5000
NUVILOVIEW_MONITOR_BACKUP_WARNING_HOURS=36
NUVILOVIEW_MONITOR_BACKUP_CRITICAL_HOURS=72
NUVILOVIEW_MONITOR_ANALYTICS_WARNING_MINUTES=45
NUVILOVIEW_MONITOR_ANALYTICS_CRITICAL_MINUTES=120
NUVILOVIEW_MONITOR_DISCORD_EVENT_WINDOW_MINUTES=15
# Developer-only safe Guild reset. Keep disabled until the migration, Bot host,
# developer settings, protected IDs, backup path, and log channel are verified.
GUILD_RESET_ENABLED=false
GUILD_RESET_DEVELOPER_IDS=
# Optional dedicated HMAC key. If omitted, AUDIT_LOG_SIGNING_SECRET or
# BETTER_AUTH_SECRET is used. Set the same value on Vercel and the Bot host.
GUILD_RESET_CONFIRMATION_SECRET=
GUILD_RESET_MAX_CHANNEL_DELETES=50
GUILD_RESET_MAX_ROLE_DELETES=25
GUILD_RESET_MAX_TOTAL_OPERATIONS=75
GUILD_RESET_GUILD_COOLDOWN_HOURS=24
GUILD_RESET_DEVELOPER_COOLDOWN_MINUTES=60
GUILD_RESET_PLAN_EXPIRES_MINUTES=10
GUILD_RESET_CODE_EXPIRES_MINUTES=5
GUILD_RESET_BACKUP_DIR=./data/backups/guild-reset
GUILD_RESET_GLOBAL_CONCURRENCY=1
# Stale lock recovery only. Make this longer than the expected maximum reset.
GUILD_RESET_LOCK_EXPIRES_MINUTES=30

# Isolated PostgreSQL integration test only. Never point this at Production.
TEST_REPLICA_DATABASE_URL=
